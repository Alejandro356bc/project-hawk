# Hawk - LLM provider configuration

# ---------------------------------------------------------------------------
# Backend / deployment (set these on Render for both services)
# ---------------------------------------------------------------------------
# URL of the Python backend as seen by the Next.js server (server-to-server).
# On Render, set this to your backend service's internal URL, e.g.:
#   http://hawk-backend:8787   (if using Render private networking)
#   https://hawk-backend.onrender.com  (public URL fallback)
HAWK_ENGINE_URL=http://127.0.0.1:8787

# Comma-separated list of origins allowed to call the Python backend.
# Set to your Render frontend URL in production, e.g.:
#   https://project-hawk.onrender.com
HAWK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# RECOMMENDED: OpenRouter free panel
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
OPENROUTER_FREE_MODELS=qwen/qwen3-coder:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free
OPENROUTER_FREE_TOOLS=on

# ---------------------------------------------------------------------------
# Free API providers
# ---------------------------------------------------------------------------

# Groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TOOLS=off

# Cerebras
CEREBRAS_API_KEY=csk-your_cerebras_api_key_here
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_TOOLS=off

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TOOLS=off

# Mistral
MISTRAL_API_KEY=mstrl_your_mistral_api_key_here
MISTRAL_TOOLS=off

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_TOOLS=off

# Ollama Cloud (hosted open models; key from https://ollama.com/settings/keys)
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
# OLLAMACLOUD_MODEL=gpt-oss:120b
OLLAMACLOUD_TOOLS=off

# Token Harbor (DeepSeek V4.1 Flash)
TOKENHARBOR_API_KEY=
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_TOOLS=off

# ---------------------------------------------------------------------------
# Local Ollama
# ---------------------------------------------------------------------------
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TOOLS=off

# ---------------------------------------------------------------------------
# Paid OpenRouter panel (legacy)
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Subscription CLI providers
# ---------------------------------------------------------------------------
# ENABLE_CLAUDE_CLI=on
# CLAUDE_MODEL=claude-opus-4-8
# CLAUDE_PERMISSION_MODE=bypassPermissions

# ENABLE_CODEX_CLI=on
# CODEX_MODEL=gpt-5.5
# CODEX_REASONING_EFFORT=xhigh
# CODEX_BYPASS_SANDBOX=off

# ---------------------------------------------------------------------------
# Optional Agy CLI wrapper
# ---------------------------------------------------------------------------
# AGY_CLI_CMD=agy --print-timeout 5m --print
# AGY_MODEL=Gemini 3.1 Pro (High)
# AGY_DISPLAY_NAME=Gemini 3.1 Pro high

# ---------------------------------------------------------------------------
# Optional default driver
# ---------------------------------------------------------------------------
# HAWK_DRIVER=GPT Oss 120B

# ---------------------------------------------------------------------------
# Optional hawk synthesizer
# ---------------------------------------------------------------------------
# HAWK_SYNTHESIZER=OpenRouter DeepSeek R1